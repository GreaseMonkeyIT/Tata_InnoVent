#!/usr/bin/env bash
# skctl - SiliconKnights bootstrap for the VISR stack on a single K3s box.
#   ./skctl up [--components telemetry,engine,language,dashboard]
#   ./skctl status
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
MODE="solo"; COMPONENTS="all"
CMD="${1:-status}"; shift || true
while [[ $# -gt 0 ]]; do case "$1" in
  --mode) MODE="$2"; shift 2;;
  --components) COMPONENTS="$2"; shift 2;;
  *) echo "unknown arg $1"; exit 1;;
esac; done

has() { [[ "$COMPONENTS" == "all" || ",$COMPONENTS," == *",$1,"* ]]; }
NS_LIST=(observability aiops dashboard)

up() {
  for ns in "${NS_LIST[@]}"; do kubectl get ns "$ns" >/dev/null 2>&1 || kubectl create ns "$ns"; done
  if has telemetry; then
    helm repo add prometheus-community https://prometheus-community.github.io/helm-charts >/dev/null 2>&1 || true
    helm repo add grafana https://grafana.github.io/helm-charts >/dev/null 2>&1 || true
    helm repo update >/dev/null
    helm upgrade --install prom prometheus-community/kube-prometheus-stack \
      -n observability -f "$HERE/values/prometheus.yaml"
    helm upgrade --install loki grafana/loki-stack -n observability -f "$HERE/values/loki.yaml"
    helm upgrade --install alloy grafana/alloy -n observability -f "$HERE/values/alloy.yaml" || echo "  (alloy install issue - logs deferred)"   # logs -> Loki
    # the eBPF collector is flaky (kernel 7.0, chart coordinates) - NON-FATAL so it can never block engine/dashboard deploys (LOG-039)
    helm repo add groundcover https://helm.groundcover.com/ >/dev/null 2>&1 || true
    helm repo update groundcover >/dev/null 2>&1 || true
    helm upgrade --install caretta groundcover/caretta -n caretta --create-namespace -f "$HERE/values/caretta.yaml" || echo "  (caretta install skipped - CO-RE/kernel-7.0 or chart issue)"
    echo "eBPF: check Caretta with 'kubectl get pods -n caretta' (the topology view stays empty without it)"
  fi
  if has engine; then
    kubectl get ns aiops >/dev/null 2>&1 || kubectl create ns aiops
    kubectl -n aiops create configmap aggregator-queries \
      --from-file=queries.yaml="$HERE/../aggregator/queries.yaml" \
      --dry-run=client -o yaml | kubectl apply -f -
    kubectl apply -f "$HERE/aggregator.yaml"
    kubectl apply -f "$HERE/engine.yaml"
    kubectl apply -f "$HERE/api.yaml"
    echo "L2 aggregator + L3 correlation engine + L4 API deployed to aiops"
  fi
  has language && echo "Narrator: api gateway /api/narrative calls Ollama (model + OLLAMA_HOST baked in api.yaml: gemma4:e4b-it-qat @ the host); deterministic template fallback if Ollama is unreachable"
  if has dashboard; then
    kubectl get ns aiops >/dev/null 2>&1 || kubectl create ns aiops
    kubectl apply -f "$HERE/dashboard.yaml"
    echo "L4 dashboard deployed to aiops - https://<node-ip>:30443 (30080 redirects to HTTPS; create the visr-auth + visr-tls Secrets first)"
  fi
  echo "skctl up done (mode=$MODE components=$COMPONENTS)"
}

status() { kubectl get pods -A -l 'tier' 2>/dev/null || kubectl get pods -A | head -40; }
case "$CMD" in up) up;; status) status;; *) echo "usage: skctl up|status"; exit 1;; esac
