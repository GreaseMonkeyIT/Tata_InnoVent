# Tata InnoVent repo: what stays local (LOG-039, LOG-057)

# --- machine-local config / sync infrastructure ---
.claude/
.obsidian/
.stfolder/
.stversions/
*.sync-conflict-*

# --- node / next.js (dashboard) — rebuilt from source, never committed ---
node_modules/
.next/
out/
npm-debug.log*
*.tsbuildinfo

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.venv/
venv/

# --- OS noise ---
Thumbs.db
Desktop.ini
.DS_Store

# --- local scratch artifacts ---
output.txt

# --- machine-local Syncthing rules ---
.stignore

# --- local-only material, not code: decks, rules, video frames, study notes ---
Design_PPT/
New_Rules_PPT/
RULES/
frames/
design_frames/
LabVIEW_CLAD/

